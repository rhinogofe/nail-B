# PostgreSQL (local)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nail_booking

# หรือแยกค่าแทน DATABASE_URL
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=nail_booking

# Render production (ตัวอย่าง)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_SSL=true

JWT_SECRET=change_this_to_something_long_and_random
# ล็อกอินค้างในเบราว์เซอร์จนกด logout · ต่ออายุอัตโนมัติเมื่อเปิดแอป (365 วัน)
JWT_EXPIRES_IN=365d

PORT=3000
# คั่นหลาย origin ด้วย comma (local + Netlify)
FRONTEND_URL=http://localhost:5173,https://resilient-parfait-eee280.netlify.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_CALLBACK_URL=http://localhost:3000/api/auth/line/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# LINE Messaging API — บอทกลาง (เปิด/ปิดได้ด้วย env)
# เปิดบอทกลาง: ตั้งทั้งสองค่า → ร้านทั่วไปใช้ /api/line/webhook + ทักบอทกลางพร้อม slug
# ร้าน Premium: แอดมินหลักติ๊ก "ใช้ LINE Bot ของร้านเอง" ในแอดมินสาขา → Webhook /api/line/webhook/{slug}
# ปิดบอทกลาง: ลบหรือเว้นว่างทั้งสองค่า → ทุกสาขากรอก Token + Secret เอง
# LINE_BOT_CHANNEL_SECRET=
# LINE_BOT_CHANNEL_ACCESS_TOKEN=

# รูปแชท — เก็บบนเซิร์ฟ 24 ชม. แล้วลบอัตโนมัติ · แคชเบราว์เซอร์ (วินาที)
CHAT_IMAGE_RETENTION_HOURS=24
CHAT_IMAGE_CACHE_MAX_AGE=86400

# โฟลเดอร์เก็บรูป (โลโก้, ภาพปก, แชท) — local ใช้ค่า default ได้
# บน Render ให้ mount Persistent Disk ที่ backend/uploads แล้วไม่ต้องตั้งก็ได้
# หรือ mount ที่ /var/data แล้วตั้ง UPLOAD_ROOT=/var/data
# UPLOAD_ROOT=/opt/render/project/src/backend/uploads
